{
  "name": "gcf-factory",
  "description": "Merges a host pull request when the configured reviewers have approved its head commit and checks have succeeded.",
  "url": "https://github.com/TigranOhanyan/github-cursor-factory",
  "public": false,
  "hook_attributes": {
    "active": false
  },
  "default_events": [],
  "default_permissions": {
    "metadata": "read",
    "contents": "write",
    "pull_requests": "write",
    "checks": "read",
    "statuses": "read",
    "issues": "write"
  }
}
